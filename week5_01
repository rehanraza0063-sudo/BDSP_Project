# PCG DFT USING TWIDDLE FACTOR
# MIT-BIH Record 100
# ============================================================

!pip install wfdb -q

import wfdb
import numpy as np
import matplotlib.pyplot as plt

# ------------------------------------------------------------
# 1. Load PCG Record
# ------------------------------------------------------------

record_path = "/content/100"

record = wfdb.rdrecord(record_path)

pcg = record.p_signal[:, 0] # Changed from ecg to pcg
fs = record.fs

print("Sampling Frequency:", fs, "Hz")
print("Total Samples:", len(pcg))
print("Channel:", record.sig_name[0])

# ------------------------------------------------------------
# 2. Select 1000 samples
# ------------------------------------------------------------

N = 1000
x = pcg[:N] # Changed from ecg to pcg

t = np.arange(N) / fs

# ------------------------------------------------------------
# 3. Plot Original PCG
# ------------------------------------------------------------

plt.figure(figsize=(14,4))
plt.plot(t, x)
plt.xlabel("Time (seconds)")
plt.ylabel("Amplitude")
plt.title("Original PCG Signal")
plt.grid()
plt.show()

# ------------------------------------------------------------
# 4. Twiddle Factor
# ------------------------------------------------------------

W = np.exp(-2j * np.pi / N)

print("\nTwiddle Factor:")
print("W =", W)

# ------------------------------------------------------------
# 5. DFT using Twiddle Factor
# ------------------------------------------------------------

X = np.zeros(N, dtype=complex)

for k in range(N):

    for n in range(N):

        # Twiddle factor W^(kn)
        twiddle = W ** (k * n)

        # DFT equation
        X[k] += x[n] * twiddle

print("\nDFT calculation completed.")

# ------------------------------------------------------------
# 6. Magnitude Spectrum
# ------------------------------------------------------------

magnitude = np.abs(X)

# Frequency axis
frequencies = np.arange(N) * fs / N

# ------------------------------------------------------------
# 7. Plot DFT
# ------------------------------------------------------------

plt.figure(figsize=(14,5))

plt.plot(
    frequencies[:N//2],
    magnitude[:N//2]
)

plt.xlabel("Frequency (Hz)")
plt.ylabel("|X[k]|")
plt.title("DFT Magnitude Spectrum using Twiddle Factor (PCG)")
plt.grid()
plt.show()
